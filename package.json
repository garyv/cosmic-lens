{
  "name": "cosmic-lens",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 3000",
    "start": "npm run dev",
    "build": "NODE_ENV=production npm run gen && vite build && tsc",
    "preview": "NODE_ENV=production npm run gen && vite preview",
    "test": "node --test \"src/**/*.test.ts\"",
    "test:browser": "playwright test",
    "gen": "NODE_ENV=production node src/scripts/generate-images.ts",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\""
  },
  "dependencies": {
    "@tanstack/react-router": "^1.170.41",
    "@tanstack/router-plugin": "^1.168.42",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-zoom-pan-pinch": "^4.2.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@rollup/plugin-yaml": "^5.0.0",
    "@types/node": "^24.19.1",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^5.0.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.6.2",
    "sharp": "^0.35.5",
    "typescript": "^5.7.2",
    "vite": "^7.3.7",
    "web-vitals": "^6.2.3"
  },
  "lint-staged": {
    "*.{ts,tsx,css,json,md}": [
      "prettier --write"
    ]
  }
}
